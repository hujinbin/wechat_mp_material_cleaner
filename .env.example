# WeChat MP API Credentials
# 微信公众号 API 凭据配置

# WeChat App ID (微信 App ID)
WECHAT_APP_ID=your_wechat_app_id_here

# WeChat App Secret (微信 App Secret)
WECHAT_APP_SECRET=your_wechat_app_secret_here

# Optional: API request timeout in seconds (可选：API请求超时时间，秒)
# WECHAT_API_TIMEOUT=30

# Optional: Number of retry attempts for failed requests (可选：失败请求重试次数)
# WECHAT_RETRY_TIMES=3

# Optional: Delay between retry attempts in seconds (可选：重试间隔，秒)
# WECHAT_RETRY_DELAY=1