# 微信公众号的 AppID 和 AppSecret
# 这是一个模板文件，请复制一份并重命名为 config.py
# 然后在 config.py 中替换成你自己的真实信息

APP_ID = "your_appid"
APP_SECRET = "your_appsecret"

# 自动发布文章配置
# 必填项: ARTICLE_TITLE, ARTICLE_AUTHOR, ARTICLE_THUMB_MEDIA_ID, ARTICLE_CONTENT 或 ARTICLE_CONTENT_FILE
ARTICLE_TITLE = "测试文章标题"
ARTICLE_AUTHOR = "作者名"
ARTICLE_DIGEST = "文章摘要（可选）"
ARTICLE_SOURCE_URL = ""

# 封面图必须是已上传到公众号素材库的图片 media_id
ARTICLE_THUMB_MEDIA_ID = "your_thumb_media_id"

# 可选: 本地封面图路径。填写后会优先自动上传并覆盖 ARTICLE_THUMB_MEDIA_ID
# 例如: ARTICLE_THUMB_IMAGE_FILE = "cover.jpg"
ARTICLE_THUMB_IMAGE_FILE = ""

# 二选一:
# 1) 直接在 ARTICLE_CONTENT 填写 HTML 正文
ARTICLE_CONTENT = "<p>这里是文章正文，支持 HTML。</p>"
# 2) 或者把正文写在本地文件中（UTF-8），例如: "article.html"
ARTICLE_CONTENT_FILE = ""

# 评论设置: 0 关闭, 1 开启
ARTICLE_NEED_OPEN_COMMENT = 1

# 仅粉丝可评论: 0 否, 1 是
ARTICLE_ONLY_FANS_CAN_COMMENT = 0
